{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueveil.local/contracts/v1/incident.schema.json",
  "title": "Incident",
  "description": "Canonical JSON form of blueveil.contracts.v1.Incident.",
  "type": "object",
  "required": ["id", "alert_ids", "status", "severity", "created_at", "updated_at", "title"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "alert_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["INCIDENT_STATUS_OPEN", "INCIDENT_STATUS_INVESTIGATING", "INCIDENT_STATUS_CONTAINED", "INCIDENT_STATUS_RESOLVED", "INCIDENT_STATUS_CLOSED"]},
    "severity": {"enum": ["SEVERITY_INFO", "SEVERITY_LOW", "SEVERITY_MEDIUM", "SEVERITY_HIGH", "SEVERITY_CRITICAL"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"}
  },
  "additionalProperties": false
}
