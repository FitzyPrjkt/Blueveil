{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueveil.local/contracts/v1/detection.schema.json",
  "title": "Detection",
  "description": "Canonical JSON form of blueveil.contracts.v1.Detection. confidence is bounded [0.0, 1.0]; at least one triggering telemetry event is required.",
  "type": "object",
  "required": ["id", "rule_id", "rule_name", "telemetry_event_ids", "detected_at", "severity", "confidence", "title"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "rule_name": {"type": "string", "minLength": 1},
    "telemetry_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "detected_at": {"type": "string", "format": "date-time"},
    "severity": {"enum": ["SEVERITY_INFO", "SEVERITY_LOW", "SEVERITY_MEDIUM", "SEVERITY_HIGH", "SEVERITY_CRITICAL"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "attributes": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "additionalProperties": false
}
